interface ErrorEntry {
  httpStatus: number;
  serviceErrorCode?: string;
  externalErrorCode?: string;
  summary: string;
  description: string;
  category: 'Business Logic' | 'Authentication' | 'Client Validation' | 'System & Gateway';
  applicableEndpoints: string[];
  remediation: string;
  sampleJson: Record<string, any>;
}

