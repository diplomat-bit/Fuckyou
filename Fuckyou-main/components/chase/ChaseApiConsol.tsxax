];

export const ChaseErrorCatalog: React.FC = () => {
  const [selectedError, setSelectedError] = useState<ErrorEntry>(ERROR_CATALOG[4]);
  const [selectedCategory, setSelectedCategory] = useState<string>('All');
  const [searchQuery, setSearchQuery] = useState<string>('');
  const [copied, setCopied] = useState<boolean>(false);

  const categories = ['All', 'Business Logic', 'Authentication', 'Client Validation', 'System & Gateway'];

  const filteredErrors = ERROR_CATALOG.filter((err) => {
    const matchesCategory = selectedCategory === 'All' || err.category === selectedCategory;
    const matchesSearch =
      err.summary.toLowerCase().includes(searchQuery.toLowerCase()) ||
      err.httpStatus.toString().includes(searchQuery) ||
      (err.serviceErrorCode && err.serviceErrorCode.toLowerCase().includes(searchQuery.toLowerCase())) ||
      (err.externalErrorCode && err.externalErrorCode.toLowerCase().includes(searchQuery.toLowerCase()));
    return matchesCategory && matchesSearch;
  });

  const copyToClipboard = (text: string) => {
    navigator.clipboard.writeText(text);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const getStatusBadge = (code: number) => {
    if (code === 401 || code === 403) return 'bg-purple-950/80 text-purple-300 border-purple-800/60';
    if (code === 409) return 'bg-amber-950/80 text-amber-300 border-amber-800/60';
    if (code >= 500) return 'bg-rose-950/80 text-rose-300 border-rose-800/60';
    return 'bg-blue-950/80 text-blue-300 border-blue-800/60';
  };

  return (
    <div className="w-full bg-[#081325] text-slate-100 rounded-2xl border border-blue-900/40 shadow-2xl overflow-hidden font-sans">
      {/* Header */}
      <div className="bg-[#0b1b36] px-6 py-4 border-b border-blue-900/50 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center space-x-3">
          <div className="p-2.5 bg-amber-500/20 rounded-xl border border-amber-500/30 text-amber-400">
            <ShieldAlert className="w-5 h-5" />
          </div>
          <div>
            <span className="font-bold text-white tracking-wide">Chase CLPWPE Error Matrix & Remediation Catalog</span>
            <span className="text-xs text-slate-400 block">HTTP Codes, Service Error Codes & Downstream Exception Handlers</span>
          </div>
        </div>

        {/* Search Bar */}
        <div className="relative min-w-[240px]">
          <Search className="w-4 h-4 absolute left-3 top-2.5 text-slate-400" />
          <input
            type="text"
            placeholder="Search error code or text..."
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            className="w-full bg-slate-900 text-xs text-slate-200 pl-9 pr-3 py-2 rounded-lg border border-slate-700 outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>
      </div>

      {/* Category Pills */}
      <div className="bg-slate-900/60 px-6 py-2.5 border-b border-slate-800 flex items-center space-x-2 overflow-x-auto">
        <span className="text-xs text-slate-400 font-semibold uppercase tracking-wider flex items-center space-x-1 mr-2">
          <Filter className="w-3 h-3 text-blue-400" />
          <span>Category:</span>
        </span>
        {categories.map((cat) => (
          <button
            key={cat}
            onClick={() => setSelectedCategory(cat)}
            className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
              selectedCategory === cat
                ? 'bg-blue-600 text-white shadow'
                : 'bg-slate-800 text-slate-400 hover:text-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Main Split Content */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-0">
        {/* Left List of Errors */}
        <div className="lg:col-span-6 border-b lg:border-b-0 lg:border-r border-slate-800 p-4 space-y-2 max-h-[560px] overflow-y-auto">
          {filteredErrors.map((err, idx) => {
            const isSelected =
              selectedError.httpStatus === err.httpStatus &&
              selectedError.serviceErrorCode === err.serviceErrorCode;
            return (
              <div
                key={idx}
                onClick={() => setSelectedError(err)}
                className={`p-3.5 rounded-xl cursor-pointer transition-all border text-left ${
                  isSelected
                    ? 'bg-blue-950/70 border-blue-500 shadow-md shadow-blue-900/20'
                    : 'bg-slate-900/60 border-slate-800/80 hover:border-slate-700'
                }`}
              >
                <div className="flex items-center justify-between mb-1.5">
                  <div className="flex items-center space-x-2">
                    <span className={`px-2 py-0.5 rounded text-xs font-mono font-bold border ${getStatusBadge(err.httpStatus)}`}>
                      HTTP {err.httpStatus}
                    </span>
                    {err.serviceErrorCode && (
                      <span className="text-xs font-mono font-bold text-amber-400 bg-amber-950/40 px-1.5 py-0.5 rounded border border-amber-800/40">
                        Code: {err.serviceErrorCode}
                      </span>
                    )}
                  </div>
                  <span className="text-[10px] text-slate-400 uppercase tracking-wider font-mono">
                    {err.category}
                  </span>
                </div>
                <div className="font-bold text-sm text-white truncate">{err.summary}</div>
                <div className="text-xs text-slate-400 mt-1 line-clamp-1">{err.description}</div>
              </div>
            );
          })}

          {filteredErrors.length === 0 && (
            <div className="p-8 text-center text-slate-500 space-y-2">
              <AlertTriangle className="w-8 h-8 text-slate-600 mx-auto" />
              <p className="text-sm font-medium">No matching error codes found</p>
            </div>
          )}
        </div>

        {/* Right Detail Pane */}
        <div className="lg:col-span-6 p-6 space-y-5 bg-slate-900/40">
          <div className="flex items-center justify-between border-b border-slate-800 pb-3">
            <div>
              <div className="flex items-center space-x-2">
                <span className={`px-2.5 py-0.5 rounded text-xs font-mono font-bold border ${getStatusBadge(selectedError.httpStatus)}`}>
                  HTTP {selectedError.httpStatus}
                </span>
                <span className="text-xs text-slate-400 uppercase tracking-wider font-mono">
                  {selectedError.category}
                </span>
              </div>
              <h3 className="text-lg font-bold text-white mt-1">{selectedError.summary}</h3>
            </div>
          </div>

          <div className="space-y-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Root Cause Description</span>
            <p className="text-sm text-slate-300 leading-relaxed bg-slate-950 p-3.5 rounded-xl border border-slate-800">
              {selectedError.description}
            </p>
          </div>

          {/* Key Identifiers */}
          <div className="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2.5">
            <div className="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
              <span clcomponents/chase/ChaseComplianceEngine.tsx
import React, { useState } from 'react';
import {
  Shield,
  Lock,
  FileCheck,
  CheckCircle2,
  AlertTriangle,
  Server,
  Globe,
  Award,
  Terminal,
  Clock,
  Eye,
  Layers,
  Key
} from 'lucide-react';

interface ComplianceRule {
  id: string;
  category: 'PCI-DSS' | 'SOC-2' | 'FIPS-140' | 'OAuth Security' | 'Auditability';
  standard: string;
  requirement: string;
  status: 'COMPLIANT' | 'AUDITED' | 'ENFORCED';
  verificationMechanism: string;
  description: string;
}

const COMPLIANCE_RULES: ComplianceRule[] = [
  {
    id: 'PCI-4.1',
    category: 'PCI-DSS',
    standard: 'PCI-DSS v4.0 Requirement 3.4',
    requirement: 'Primary Account Number (PAN) Zero Exposure',
    status: 'ENFORCED',
    verificationMechanism: '128-bit UUID Reference Obfuscation',
    description: 'No 16-digit PAN is transmitted across CLPWPE endpoints. All cardholder accounts are tokenized via account-reference-universal-unique-identifier.'
  },
  {
    id: 'OAUTH-2.1',
    category: 'OAuth Security',
    standard: 'RFC 6749 2-Legged OAuth Client Credentials',
    requirement: 'Mandatory Common 2-Legged Bearer Enforcement',
    status: 'ENFORCED',
    verificationMechanism: 'HMAC-SHA256 & RSA-2048 Signed JWTs with "card" scope',
    description: 'Endpoint requests are rejected at perimeter with HTTP 401 unless accompanied by valid signed bearer token with strict time-to-live.'
  },
  {
    id: 'AUDIT-1.0',
    category: 'Auditability',
    standard: 'JPMorgan Chase Enterprise Telemetry Guideline 88.3',
    requirement: 'Immutable 128-bit Trace-ID Header Correlation',
    status: 'AUDITED',
    verificationMechanism: 'Hex-128 Request Header Enclave Logging',
    description: 'Every POST and PUT request must supply a 32-hex character trace-id persisted in immutable write-once distributed audit ledgers.'
  },
  {
    id: 'FIPS-140-3',
    category: 'FIPS-140',
    standard: 'NIST FIPS 140-2 / 140-3 Level 3',
    requirement: 'Hardware Security Module (HSM) Key Protection',
    status: 'COMPLIANT',
    verificationMechanism: 'Dedicated Hardware Cryptographic Enclaves',
    description: 'Customer token decryption and partner identity verification execute inside tamper-evident HSM hardware partitions.'
  },
  {
    id: 'SOC2-CC6',
    category: 'SOC-2',
    standard: 'AICPA SOC 2 Type II Trust Criteria CC6.1-6.8',
    requirement: 'Logical Access Control & Least Privilege Segregation',
    status: 'AUDITED',
    verificationMechanism: 'Role-Based Access Control (RBAC) & Scope Filters',
    description: 'Partners are strictly constrained to card loyalty enrollment domains without access to transactional debit balances or direct payment rails.'
  }
];

export const ChaseComplianceEngine: React.FC = () => {
  const [selectedRule, setSelectedRule] = useState<ComplianceRule>(COMPLIANCE_RULES[0]);
  const [activeCategory, setActiveCategory] = useState<string>('All');
  const [isAuditing, setIsAuditing] = useState<boolean>(false);
  const [auditTimestamp, setAuditTimestamp] = useState<string>(new Date().toISOString());

  const categories = ['All', 'PCI-DSS', 'OAuth Security', 'Auditability', 'FIPS-140', 'SOC-2'];

  const filteredRules = COMPLIANCE_RULES.filter(
    (rule) => activeCategory === 'All' || rule.category === activeCategory
  );

  const runLiveAudit = () => {
    setIsAuditing(true);
    setTimeout(() => {
      setIsAuditing(false);
      setAuditTimestamp(new Date().toISOString());
    }, 900);
  };

  return (
    <div className="w-full bg-[#081325] text-slate-100 rounded-2xl border border-blue-900/40 shadow-2xl overflow-hidden font-sans">
      {/* Top Banner */}
      <div className="bg-[#0b1b36] px-6 py-4 border-b border-blue-900/50 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center space-x-3">
          <div className="p-2.5 bg-emerald-500/20 rounded-xl border border-emerald-500/30 text-emerald-400">
            <Shield className="w-5 h-5" />
          </div>
          <div>
            <span className="font-bold text-white tracking-wide">Enterprise Compliance & Regulatory Governance Engine</span>
            <span className="text-xs text-slate-400 block">PCI-DSS v4.0, SOC-2 Type II & FIPS-140 Cryptographic Attestation</span>
          </div>
        </div>

        <button
          onClick={runLiveAudit}
          disabled={isAuditing}
          className="flex items-center space-x-2 px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition shadow-lg shadow-emerald-900/20 disabled:opacity-50"
        >
          <FileCheck className={`w-3.5 h-3.5 ${isAuditing ? 'animate-spin' : ''}`} />
          <span>{isAuditing ? 'Auditing Enclaves...' : 'Verify Live Attestation'}</span>
        </button>
      </div>

      {/* Category Tabs */}
      <div className="bg-slate-900/60 px-6 py-2.5 border-b border-slate-800 flex items-center space-x-2 overflow-x-auto">
        <span className="text-xs text-slate-400 font-semibold uppercase tracking-wider mr-2">Framework:</span>
        {categories.map((cat) => (
          <button
            key={cat}
            onClick={() => setActiveCategory(cat)}
            className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
              activeCategory === cat
                ? 'bg-blue-600 text-white shadow'
                : 'bg-slate-800 text-slate-400 hover:text-slate-200'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      {/* Main Grid Content */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-0">
        {/* Left Rules List */}
        <div className="lg:col-span-6 border-b lg:border-b-0 lg:border-r border-slate-800 p-4 space-y-2 max-h-[500px] overflow-y-auto">
          {filteredRules.map((rule) => {
            const isSelected = selectedRule.id === rule.id;
            return (
              <div
                key={rule.id}
                onClick={() => setSelectedRule(rule)}
                className={`p-4 rounded-xl cursor-pointer transition-all border text-left ${
                  isSelected
                    ? 'bg-blue-950/70 border-blue-500 shadow-md shadow-blue-900/20'
                    : 'bg-slate-900/60 border-slate-800/80 hover:border-slate-700'
                }`}
              >
                <div className="flex items-center justify-between mb-1.5">
                  <span className="text-xs font-mono font-bold text-blue-400 bg-blue-950/60 px-2 py-0.5 rounded border border-blue-800/40">
                    {rule.standard}
                  </span>
                  <span className="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 uppercase tracking-wider">
                    {rule.status}
                  </span>
                </div>
                <div className="font-bold text-sm text-white">{rule.requirement}</div>
                <div className="text-xs text-slate-400 mt-1 line-clamp-1">{rule.description}</div>
              </div>
            );
          })}
        </div>

        {/* Right Deep Dive Inspector */}
        <div className="lg:col-span-6 p-6 space-y-5 bg-slate-900/40">
          <div className="flex items-center justify-between border-b border-slate-800 pb-3">
            <div>
              <span className="text-xs font-mono text-emerald-400 font-bold uppercase">{selectedRule.category} Attestation</span>
              <h3 className="text-lg font-bold text-white mt-0.5">{selectedRule.requirement}</h3>
            </div>
            <span className="p-2 bg-emerald-500/10 rounded-lg text-emerald-400 border border-emerald-500/30">
              <CheckCircle2 className="w-5 h-5" />
            </span>
          </div>

          <div className="space-y-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Regulatory Directive</span>
            <p className="text-sm text-slate-300 leading-relaxed bg-slate-950 p-3.5 rounded-xl border border-slate-800">
              {selectedRule.description}
            </p>
          </div>

          <div className="space-y-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Technical Enforcement Mechanism</span>
            <div className="p-3.5 bg-blue-950/40 border border-blue-800/40 rounded-xl text-xs text-blue-200 font-mono flex items-center space-x-2">
              <Lock className="w-4 h-4 text-emerald-400 shrink-0" />
              <span>{selectedRule.verificationMechanism}</span>
            </div>
          </div>

          {/* Security Checklist */}
          <div className="space-y-2 pt-2 border-t border-slate-800">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Security Architecture Checklist</span>
            <div className="space-y-1.5 text-xs">
              <div className="flex items-center space-x-2 text-slate-300">
                <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                <span>Zero raw PAN transmission across public gateways</span>
              </div>
              <div className="flex items-center space-x-2 text-slate-300">
                <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                <span>128-bit Trace-ID mandatory on all POST / PUT requests</span>
              </div>
              <div className="flex items-center space-x-2 text-slate-300">
                <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                <span>2-Legged OAuth Token URL: https://api-sandbox.chase.com/ccoauth/token</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Footer Attestation Bar */}
      <div className="bg-slate-950 px-6 py-3 border-t border-slate-800 flex flex-wrap items-center justify-between text-xs text-slate-500 gap-2">
        <div className="flex items-center space-x-2">
          <Clock className="w-3.5 h-3.5 text-emerald-400" />
          <span>Last Automated Enclave Attestation: {auditTimestamp}</span>
        </div>
        <div className="font-mono text-emerald-400 text-[11px] font-bold">
          STATUS: 100% REGULATORY COMPLIANT
        </div>
      </div

export default ChaseComplianceEngine;
>
    </div>
  );
};components/chase/ChaseEnrollmentWorkflow.tsx
import React, { useState } from 'react';
import {
  UserCheck,
  CheckCircle2,
  ArrowRight,
  ShieldCheck,
  Zap,
  CreditCard,
  Layers,
  Sparkles,
  RotateCcw,
  ExternalLink,
  ChevronRight
} from 'lucide-react';

export interface WorkflowCard {
  id: string;
  name: string;
  code: string;
  annualFee: string;
  pointsMultiplier: string;
  autoEnrollSupported: boolean;
  colorGradient: string;
  description: string;
}

const CARDS_DATA: WorkflowCard[] = [
  {
    id: 'sapphire-reserve',
    name: 'Chase Sapphire Reserve®',
    code: 'SAPPHIRE_RESERVE',
    annualFee: '$550',
    pointsMultiplier: '1.50¢ per point on Pay with Points',
    autoEnrollSupported: true,
    colorGradient: 'from-slate-900 via-blue-950 to-blue-900 border-blue-500/50',
    description: 'Premier travel luxury card with instant point-pay redemption on flights, dining, and retail partners.'
  },
  {
    id: 'jpm-reserve',
    name: 'J.P. Morgan Reserve Card',
    code: 'JPM_RESERVE',
    annualFee: '$595',
    pointsMultiplier: '1.50¢ per point (Private Client Exclusive)',
    autoEnrollSupported: true,
    colorGradient: 'from-zinc-900 via-black to-slate-900 border-amber-500/50',
    description: 'Crafted from brass and palladium. For Private Bank clients requiring VIP rewards integration.'
  },
  {
    id: 'sapphire-preferred',
    name: 'Chase Sapphire Preferred®',
    code: 'SAPPHIRE_PREFERRED',
    annualFee: '$95',
    pointsMultiplier: '1.25¢ per point on Pay with Points',
    autoEnrollSupported: true,
    colorGradient: 'from-blue-950 via-sky-950 to-slate-900 border-sky-500/50',
    description: 'Most popular consumer travel rewards card with robust flexibility across merchant checkouts.'
  },
  {
    id: 'ink-business-preferred',
    name: 'Ink Business Preferred®',
    code: 'INK_BUSINESS_PREFERRED',
    annualFee: '$95',
    pointsMultiplier: '1.25¢ per point (Commercial)',
    autoEnrollSupported: true,
    colorGradient: 'from-indigo-950 via-slate-900 to-indigo-900 border-indigo-500/50',
    description: 'Designed for high-volume merchant inventory purchases and business partner loyalty enrollment.'
  },
  {
    id: 'freedom-unlimited',
    name: 'Chase Freedom Unlimited®',
    code: 'FREEDOM_UNLIMITED',
    annualFee: '$0',
    pointsMultiplier: '1.00¢ per point (Cash Back equivalent)',
    autoEnrollSupported: true,
    colorGradient: 'from-slate-900 via-emerald-950 to-slate-900 border-emerald-500/50',
    description: 'Zero annual fee card offering frictionless auto-enrollment for general consumer shopping.'
  },
  {
    id: 'slate',
    name: 'Chase Slate Edge℠',
    code: 'SLATE',
    annualFee: '$0',
    pointsMultiplier: 'Basic Points Ratio',
    autoEnrollSupported: false,
    colorGradient: 'from-neutral-900 via-slate-950 to-neutral-900 border-slate-600/50',
    description: 'Credit-building card profile. Requires explicit self-enrollment step without auto-enroll.'
  }
];

export const ChaseEnrollmentWorkflow: React.FC = () => {
  const [selectedCard, setSelectedCard] = useState<WorkflowCard>(CARDS_DATA[0]);
  const [enrollmentMode, setEnrollmentMode] = useState<'AUTOENROLL' | 'ENROLL'>('AUTOENROLL');
  const [currentStep, setCurrentStep] = useState<number>(1);
  const [isProcessing, setIsProcessing] = useState<boolean>(false);
  const [simulatedAccountUUID, setSimulatedAccountUUID] = useState<string>('c8391024-912f-48e1-93bf-192837465019');
  const [enrollmentResult, setEnrollmentResult] = useState<'SUCCESS' | 'UNENROLLED' | null>(null);

  const handleRunFlow = () => {
    setIsProcessing(true);
    setCurrentStep(2);

    setTimeout(() => {
      setCurrentStep(3);
      setTimeout(() => {
        setCurrentStep(4);
        setIsProcessing(false);
        setEnrollmentResult('SUCCESS');
      }, 700);
    }, 600);
  };

  const handleReset = () => {
    setCurrentStep(1);
    setIsProcessing(false);
    setEnrollmentResult(null);
    setSimulatedAccountUUID(
      'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
        const r = (Math.random() * 16) | 0;
        const v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      })
    );
  };

  const handleUnenroll = () => {
    setIsProcessing(true);
    setTimeout(() => {
      setIsProcessing(false);
      setEnrollmentResult('UNENROLLED');
    }, 600);
  };

  return (
    <div className="w-full bg-[#081325] text-slate-100 rounded-2xl border border-blue-900/40 shadow-2xl overflow-hidden font-sans">
      {/* Header bar */}
      <div className="bg-[#0b1b36] px-6 py-4 border-b border-blue-900/50 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center space-x-3">
          <div className="p-2.5 bg-blue-600/20 rounded-xl border border-blue-500/30 text-blue-400">
            <UserCheck className="w-5 h-5" />
          </div>
          <div>
            <span className="font-bold text-white tracking-wide">Cardholder Pay With Points Interactive Onboarding</span>
            <span className="text-xs text-slate-400 block">Simulate Auto-Enrollment & Self-Enrollment across Chase RPC Portfolios</span>
          </div>
        </div>

        <button
          onClick={handleReset}
          className="flex items-center space-x-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold transition"
        >
          <RotateCcw className="w-3.5 h-3.5" />
          <span>Reset Simulation</span>
        </button>
      </div>

      {/* Main Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-0">
        {/* Left Side: Product Selector & Configuration */}
        <div className="lg:col-span-5 border-b lg:border-b-0 lg:border-r border-slate-800 p-6 space-y-5">
          <div>
            <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">1. Select Card Product (RPC)</label>
            <div className="grid grid-cols-1 gap-2.5 mt-2.5">
              {CARDS_DATA.map((card) => {
                const isSelected = selectedCard.id === card.id;
                return (
                  <div
                    key={card.id}
                    onClick={() => {
                      setSelectedCard(card);
                      if (!card.autoEnrollSupported && enrollmentMode === 'AUTOENROLL') {
                        setEnrollmentMode('ENROLL');
                      }
                    }}
                    className={`p-3.5 rounded-xl cursor-pointer border transition-all ${
                      isSelected
                        ? `bg-gradient-to-r ${card.colorGradient} shadow-lg scale-[1.01]`
                        : 'bg-slate-900/60 border-slate-800 hover:border-slate-700'
                    }`}
                  >
                    <div className="flex items-center justify-between">
                      <span className="font-bold text-sm text-white">{card.name}</span>
                      <span className="text-xs font-mono text-blue-300 font-bold">{card.annualFee}</span>
                    </div>
                    <div className="text-[11px] text-slate-300 mt-1 flex items-center justify-between">
                      <span>{card.pointsMultiplier}</span>
                      {card.autoEnrollSupported ? (
                        <span className="text-emerald-400 text-[10px] font-semibold bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-800/40">
                          Auto-Enroll Ready
                        </span>
                      ) : (
                        <span className="text-amber-400 text-[10px] font-semibold bg-amber-950/60 px-1.5 py-0.5 rounded border border-amber-800/40">
                          Self-Enroll Only
                        </span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Enrollment Mode Selector */}
          <div className="space-y-2">
            <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">2. Enrollment Mode Directive</label>
            <div className="grid grid-cols-2 gap-2">
              <button
                disabled={!selectedCard.autoEnrollSupported}
                onClick={() => setEnrollmentMode('AUTOENROLL')}
                className={`p-3 rounded-lg text-xs font-bold transition-all border text-left ${
                  enrollmentMode === 'AUTOENROLL'
                    ? 'bg-blue-600 text-white border-blue-400 shadow-md'
                    : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200 disabled:opacity-40 disabled:cursor-not-allowed'
                }`}
              >
                <div className="flex items-center space-x-1.5">
                  <Zap className="w-3.5 h-3.5" />
                  <span>AUTOENROLL</span>
                </div>
                <div className="text-[10px] font-normal opacity-80 mt-1">Frictionless checkout prompt</div>
              </button>

              <button
                onClick={() => setEnrollmentMode('ENROLL')}
                className={`p-3 rounded-lg text-xs font-bold transition-all border text-left ${
                  enrollmentMode === 'ENROLL'
                    ? 'bg-blue-600 text-white border-blue-400 shadow-md'
                    : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200'
                }`}
              >
                <div className="flex items-center space-x-1.5">
                  <UserCheck className="w-3.5 h-3.5" />
                  <span>ENROLL</span>
                </div>
                <div className="text-[10px] font-normal opacity-80 mt-1">Customer Opt-In toggle</div>
              </button>
            </div>
          </div>

          {/* Action Button */}
          <button
            onClick={handleRunFlow}
            disabled={isProcessing}
            className="w-full py-3 px-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold rounded-xl text-xs uppercase tracking-wider shadow-lg shadow-blue-900/30 transition-all flex items-center justify-center space-x-2 disabled:opacity-50"
          >
            <Sparkles className="w-4 h-4 text-amber-300" />
            <span>Execute CLPWPE Enrollment Pipeline</span>
          </button>
        </div>

        {/* Right Side: Step-by-Step Visualization & Ledger Result */}
        <div className="lg:col-span-7 p-6 space-y-6 bg-slate-900/40">
          {/* Step Progress Tracker */}
          <div className="space-y-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Execution Pipeline</span>
            <div className="grid grid-cols-4 gap-2 text-center text-[11px] font-semibold">
              {[
                { num: 1, label: 'Client Trigger' },
                { num: 2, label: 'OAuth Token' },
                { num: 3, label: 'MRM Eligibility' },
                { num: 4, label: 'Ledger Commit' },
              ].map((step) => {
                const isActive = currentStep >= step.num;
                return (
                  <div
                    key={step.num}
                    className={`p-2.5 rounded-lg border transition-all ${
                      isActive
                        ? 'bg-blue-950 border-blue-400 text-blue-300 shadow'
                        : 'bg-slate-950/60 border-slate-800 text-slate-500'
                    }`}
                  >
                    <div className="font-mono text-xs">{step.num}</div>
                    <div className="truncate mt-0.5">{step.label}</div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Active Card Virtual Preview */}
          <div className={`p-5 rounded-2xl border bg-gradient-to-r ${selectedCard.colorGradient} shadow-xl relative overflow-hidden`}>
            <div className="flex justify-between items-start">
              <div>
                <span className="text-[10px] font-mono tracking-widest text-slate-400 uppercase">CHASE LOYALTY CARD PROFILE</span>
                <h4 className="text-lg font-bold text-white mt-0.5">{selectedCard.name}</h4>
              </div>
              <CreditCard className="w-8 h-8 text-white/80" />
            </div>

            <div className="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs">
              <div>
                <span className="text-[10px] text-slate-400 uppercase block font-mono">ACCOUNT REFERENCE UUID</span>
                <span className="font-mono text-blue-200 text-[11px]">{simulatedAccountUUID}</span>
              </div>
              <div className="text-right">
                <span className="text-[10px] text-slate-400 uppercase block font-mono">STATUS</span>
                <span className="font-bold text-emerald-400">
                  {enrollmentResult === 'SUCCESS'
                    ? enrollmentMode === 'AUTOENROLL'
                      ? 'AUTOENROLLED'
                      : 'ENROLLED'
                    : enrollmentResult === 'UNENROLLED'
                    ? 'UN-ENROLLED'
                    : 'NOT_ENROLLED'}
                </span>
              </div>
            </div>
          </div>

          {/* Response Payload Simulator */}
          {enrollmentResult && (
            <div className="space-y-3 bg-slate-950 p-4 rounded-xl border border-slate-800">
              <div className="flex items-center justify-between border-b border-slate-800 pb-2">
                <span className="text-xs font-bold text-emerald-400 flex items-center space-x-1.5">
                  <CheckCircle2 className="w-4 h-4" />
                  <span>200 OK - EnrollmentResponse Received</span>
                </span>
                {enrollmentResult === 'SUCCESS' && (
                  <button
                    onClick={handleUnenroll}
                    className="text-xs text-rose-400 hover:text-rose-300 font-semibold underline"
                  >
                    Test PUT Un-Enroll
                  </button>
                )}
              </div>

              <pre className="text-xs font-mono text-emerald-300 overflow-x-auto p-2 bg-black/50 rounded-lg">
                {JSON.stringify(
                  {
                    enrollment: {
                      enrollmentStatusName:
                        enrollmentResult === 'SUCCESS'
                          ? enrollmentMode === 'AUTOENROLL'
                            ? 'AUTOENROLLED'
                            : 'ENROLLED'
                          : 'UN-ENROLLED',
                      enrollmentStatusDate: new Date().toISOString().split('T')[0]
                    },
                    product: {
                      merchantDefinedProductCode: selectedCard.code
                    }
                  },
                  null,
                  2
                )}
              </pre>
            </div>
          )}

          {/* Key Advantages Checklist */}
          <div className="grid grid-cols-2 gap-3 text-xs">
            <div className="p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1">
              <div className="flex items-center space-x-1.5 font-bold text-slate-200">
                <ShieldCheck className="w-4 h-4 text-emerald-400" />
                <span>Zero Friction Conversion</span>
              </div>
              <p className="text-[11px] text-slate-400">Cardholders complete enrollment without leaving merchant checkout.</p>
            </div>

            <div className="p-3 bg-slate-950/80 rounded-xl border border-slate-800 space-y-1">
              <div className="flex items-center space-x-1.5 font-bold text-slate-200">
                <Sparkles className="w-4 h-4 text-amber-400" />
                <span>Immediate Point Redemption</span>
              </div>
              <p className="text-[11px] text-slate-400">Points available instantly for checkout split-tender payments.</p>
            </div>
          </div>
        </div>
      </div>

      {/* Footer Info */}
      <div className="bg-slate-950 px-6 py-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-500">
        <span>Swagger Spec Definition: EnrollmentResponse (Enrollment + Transaction Product)</span>
        <span </div>
  );
};

export default ChaseEnrollmentWorkflow;
className="font-mono text-[11px]">RPC Matrix v1.0.0</span>
      </div>
    components/chase/ChaseLiveMetrics.tsx
import React, { useState, useEffect } from 'react';
import {
  TrendingUp,
  Activity,
  Zap,
  Globe,
  Clock,
  ShieldCheck,
  Award,
  Users,
  CreditCard,
  Layers,
  ArrowUpRight,
  ArrowDownRight
} from 'lucide-react';

interface MetricCardProps {
  title: string;
  value: string;
  change: string;
  isPositive: boolean;
  subtext: string;
  icon: React.ReactNode;
}

const MetricCard: React.FC<MetricCardProps> = ({ title, value, change, isPositive, subtext, icon }) => (
  <div className="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-lg relative overflow-hidden space-y-3">
    <div className="flex items-center justify-between">
      <span className="text-xs uppercase font-mono text-slate-400 font-bold">{title}</span>
      <div className="p-2 bg-slate-800 rounded-lg text-blue-400">{icon}</div>
    </div>
    <div className="flex items-baseline justify-between">
      <span className="text-2xl font-bold font-mono text-white tracking-tight">{value}</span>
      <div className={`flex items-center space-x-0.5 text-xs font-bold ${isPositive ? 'text-emerald-400' : 'text-amber-400'}`}>
        {isPositive ? <ArrowUpRight className="w-3.5 h-3.5" /> : <ArrowDownRight className="w-3.5 h-3.5" />}
        <span>{change}</span>
      </div>
    </div>
    <div className="text-[11px] text-slate-400 border-t border-slate-800/80 pt-2">{subtext}</div>
  </div>
);

export const ChaseLiveMetrics: React.FC = () => {
  const [totalVolume, setTotalVolume] = useState<number>(48291040);
  const [activeTPS, setActiveTPS] = useState<number>(1420);
  const [p99Latency, setP99Latency] = useState<number>(38.2);

  // Live jitter for real-time telemetry feel
  useEffect(() => {
    const interval = setInterval(() => {
      setTotalVolume((prev) => prev + Math.floor(Math.random() * 25) + 10);
      setActiveTPS(1380 + Math.floor(Math.random() * 120));
      setP99Latency(Number((37.5 + Math.random() * 1.8).toFixed(1)));
    }, 1500);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="w-full bg-[#081325] text-slate-100 rounded-2xl border border-blue-900/40 shadow-2xl overflow-hidden font-sans">
      {/* Header bar */}
      <div className="bg-[#0b1b36] px-6 py-4 border-b border-blue-900/50 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center space-x-3">
          <div className="p-2.5 bg-blue-600/20 rounded-xl border border-blue-500/30 text-blue-400">
            <Activity className="w-5 h-5" />
          </div>
          <div>
            <span className="font-bold text-white tracking-wide">Chase Global Loyalty & Telemetry Analytics</span>
            <span className="text-xs text-slate-400 block">Real-time Performance, Conversion Lift & SLA Monitoring</span>
          </div>
        </div>

        <div className="flex items-center space-x-2">
          <span className="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse" />
          <span className="text-xs font-mono font-bold text-emerald-300">STREAM ACTIVE</span>
        </div>
      </div>

      {/* Metric Cards Grid */}
      <div className="p-6 space-y-6">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <MetricCard
            title="Global API Invocations"
            value={totalVolume.toLocaleString()}
            change="+18.4%"
            isPositive={true}
            subtext="Total enrollment & verification calls (24h)"
            icon={<Globe className="w-4 h-4" />}
          />

          <MetricCard
            title="Current Throughput"
            value={`${activeTPS} req/s`}
            change="+4.1%"
            isPositive={true}
            subtext="Peak capacity certified to 98,000 TPS"
            icon={<Zap className="w-4 h-4 text-amber-400" />}
          />

          <MetricCard
            title="P99 Response Latency"
            value={`${p99Latency} ms`}
            change="-2.8%"
            isPositive={true}
            subtext="Global edge POPs with TLS session reuse"
            icon={<Clock className="w-4 h-4 text-emerald-400" />}
          />

          <MetricCard
            title="Merchant Checkout Lift"
            value="+28.6%"
            change="+5.2%"
            isPositive={true}
            subtext="Average order value increase with Pay with Points"
            icon={<TrendingUp className="w-4 h-4 text-indigo-400" />}
          />
        </div>

        {/* Secondary Detailed Breakdown */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Card Product Distribution */}
          <div className="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-2">
              <CreditCard className="w-4 h-4 text-blue-400" />
              <span>Enrollment Share by Card Portfolio</span>
            </span>

            <div className="space-y-3">
              {[
                { name: 'Sapphire Reserve & Preferred', pct: 44, color: 'bg-blue-500' },
                { name: 'Freedom Unlimited & Flex', pct: 32, color: 'bg-emerald-500' },
                { name: 'Ink Business Portfolios', pct: 18, color: 'bg-indigo-500' },
                { name: 'Slate & Co-Branded', pct: 6, color: 'bg-slate-500' },
              ].map((item, i) => (
                <div key={i} className="space-y-1">
                  <div className="flex justify-between text-xs">
                    <span className="text-slate-300 font-medium">{item.name}</span>
                    <span className="font-mono text-slate-400">{item.pct}%</span>
                  </div>
                  <div className="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                    <div className={`h-full ${item.color} rounded-full`} style={{ width: `${item.pct}%` }} />
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Channel Breakdown */}
          <div className="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-2">
              <Layers className="w-4 h-4 text-emerald-400" />
              <span>Inbound Origin Channel Types</span>
            </span>

            <div className="space-y-3">
              {[
                { channel: 'MOBILE_NATIVE (iOS / Android)', pct: 62, count: '29.9M calls' },
                { channel: 'WEB (Desktop Portal)', pct: 28, count: '13.5M calls' },
                { channel: 'MOBILE_WEB (Responsive)', pct: 8, count: '3.8M calls' },
                { channel: 'POS_TERMINAL (In-Store)', pct: 2, count: '0.9M calls' },
              ].map((ch, i) => (
                <div key={i} className="flex items-center justify-between p-2 bg-slate-950 rounded-lg border border-slate-800/80 text-xs">
                  <div>
                    <div className="font-bold text-slate-200">{ch.channel}</div>
                    <div className="text-[10px] text-slate-500">{ch.count}</div>
                  </div>
                  <span className="font-mono font-bold text-blue-400">{ch.pct}%</span>
                </div>
              ))}
            </div>
          </div>

          {/* SLA Performance Box */}
          <div className="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4 flex flex-col justify-between">
            <div className="space-y-3">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-2">
                <ShieldCheck className="w-4 h-4 text-amber-400" />
                <span>Enterprise Availability SLA</span>
              </span>

              <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 text-center space-y-1">
                <div className="text-3xl font-mono font-bold text-emerald-400">99.999%</div>
                <div className="text-xs text-slate-400">Past 365 Days Guaranteed Uptime</div>
              </div>

              <div className="space-y-1.5 text-xs text-slate-400">
                <div className="flex justify-between">
                  <span>Downstream MRM Health:</span>
                  <span className="text-emerald-400 font-bold">100% UP</span>
                </div>
                <div className="flex justify-between">
                  <span>OAuth Broker Gateway:</span>
                  <span className="text-emerald-400 font-bold">100% UP</span>
                </div>
                <div className="flex justify-between">
                  <span>Trace ID Auditing Store:</span>
                  <span className="text-emerald-400 font-bold">100% UP</span>
                </div>
              </div>
            </div>

            <div className="p-3 bg-blue-950/40 rounded-lg border border-blue-800/40 text-[11px] text-blue-300">
              Multi-Region Active-Active failover enabled with automated 250ms circuit breakers.
            </div>
          </div>
        </div>
      </div>

      {/* Footer */}
      <div className="bg-slate-950 px-6 py-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-500">
        <span>Real-time Stream: SSE / WebSocket Enterprise Metric Gateway</span>
        <span className="font-mono text-[11px]">telemetry.chase.com/clpwpe/v1</span>
      </div>
    </div>
  );
};

export default ChaseLiveMetrics;