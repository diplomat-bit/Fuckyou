import React, { useState, useEffect, useId } from 'react';
import {
  Play,
  Copy,
  Check,
  RotateCcw,
  Sparkles,
  ShieldCheck,
  Activity,
  Terminal,
  Layers,
  Code2,
  Lock,
  ArrowRight,
  Globe,
  Sliders,
  CheckCircle2,
  AlertTriangle,
  XCircle,
  Clock,
  Send,
  Zap,
  Download
} from 'lucide-react';

export interface EnrollmentData {
  enrollmentStatusName: 'AUTOENROLLED' | 'ENROLLED' | 'UN-ENROLLED' | 'OPTED_OUT' | 'OPTED_IN' | 'NOT_ENROLLED';
  enrollmentStatusDate: string;
}

export interface TransactionProductData {
  merchantDefinedProductCode:
    | 'SAPPHIRE_RESERVE'
    | 'JPM_RESERVE'
    | 'SAPPHIRE_PREFERRED'
    | 'SAPPHIRE_NO_FEE'
    | 'INK_BUSINESS_PREFERRED'
    | 'INK_PLUS'
    | 'INK_BUSINESS_CASH'
    | 'INK_CASH'
    | 'INK_BUSINESS_UNLIMITED'
    | 'FREEDOM_UNLIMITED'
    | 'FREEDOM'
    | 'FREEDOM_STUDENT'
    | 'SLATE';
}

export interface EnrollmentResponse {
  enrollment: EnrollmentData;
  product: TransactionProductData;
}

export interface ApiErrorResponse {
  errorDescription: string;
  serviceErrorCode?: string;
  externalErrorCode?: string;
}

export type EndpointKey = 'PING' | 'POST_ENROLL' | 'PUT_UNENROLL';

export interface ScenarioPreset {
  id: string;
  name: string;
  endpoint: EndpointKey;
  description: string;
  expectedStatus: number;
  params: {
    uuid?: string;
    enrollmentType?: 'AUTOENROLL' | 'ENROLL';
    externalAccountId?: string;
    channelType?: string;
    productCode?: TransactionProductData['merchantDefinedProductCode'];
    customError?: ApiErrorResponse;
    authValid?: boolean;
    simulateDelay?: number;
  };
}

const PRESET_SCENARIOS: ScenarioPreset[] = [
  {
    id: 'pwp-autoenroll-sapphire',
    name: 'Auto-Enroll Sapphire Reserve (200 OK)',
    endpoint: 'POST_ENROLL',
    description: 'Successful auto-enrollment for a high-tier Chase Sapphire Reserve cardholder with immediate point-pay provisioning.',
    expectedStatus: 200,
    params: {
      uuid: '7e9c991a-8c54-41d9-9599-73e4b77f98b1',
      enrollmentType: 'AUTOENROLL',
      externalAccountId: 'CHASE-PRTNR-99482103',
      channelType: 'MOBILE_NATIVE',
      productCode: 'SAPPHIRE_RESERVE',
      authValid: true,
      simulateDelay: 280
    }
  },
  {
    id: 'pwp-enroll-freedom',
    name: 'Self-Enroll Freedom Unlimited (200 OK)',
    endpoint: 'POST_ENROLL',
    description: 'Merchant checkout digital wallet initiated self-enrollment into Pay with Points program.',
    expectedStatus: 200,
    params: {
      uuid: '3a18e032-478a-4d2b-9806-03c6218d8442',
      enrollmentType: 'ENROLL',
      externalAccountId: 'CHASE-PRTNR-10294821',
      channelType: 'WEB',
      productCode: 'FREEDOM_UNLIMITED',
      authValid: true,
      simulateDelay: 320
    }
  },
  {
    id: 'pwp-unenroll-slate',
    name: 'Un-Enroll Slate Card (200 OK)',
    endpoint: 'PUT_UNENROLL',
    description: 'Cardholder requests un-enrollment / opt-out from merchant loyalty checkout prompt.',
    expectedStatus: 200,
    params: {
      uuid: '99bf0a2c-f601-4475-bce1-d70cbfa481e9',
      enrollmentType: 'ENROLL',
      externalAccountId: 'CHASE-PRTNR-48201948',
      channelType: 'WEB',
      productCode: 'SLATE',
      authValid: true,
      simulateDelay: 240
    }
  },
  {
    id: 'pwp-err-409-ineligible',
    name: 'Error 409: Account Ineligible (Code 601)',
    endpoint: 'POST_ENROLL',
    description: 'Attempt to enroll an account that does not have an active Ultimate Rewards eligible profile or is restricted.',
    expectedStatus: 409,
    params: {
      uuid: 'c82701e1-e63b-4876-bce7-76ad85611c01',
      enrollmentType: 'ENROLL',
      externalAccountId: 'CHASE-PRTNR-RESTRICTED',
      channelType: 'WEB',
      customError: {
        errorDescription: 'Account is not eligible for Pay with Points loyalty rewards program.',
        serviceErrorCode: '601',
        externalErrorCode: 'ACCOUNT_INELIGIBLE_FOR_REWARDS'
      },
      authValid: true,
      simulateDelay: 350
    }
  },
  {
    id: 'pwp-err-401-unauthorized',
    name: 'Error 401: OAuth Token Expired / Invalid',
    endpoint: 'POST_ENROLL',
    description: 'The 2-legged OAuth bearer token has expired or is invalid. Customer must re-authenticate.',
    expectedStatus: 401,
    params: {
      uuid: 'e100f91a-b333-4001-92cb-102938475612',
      enrollmentType: 'ENROLL',
      externalAccountId: 'CHASE-PRTNR-00000000',
      channelType: 'MOBILE_APP',
      authValid: false,
      customError: {
        errorDescription: 'Authorization Failure. Customer Token does not match or has expired.',
        serviceErrorCode: 'AUTH_TOKEN_EXPIRED',
        externalErrorCode: 'OAUTH_VERIFICATION_FAILED'
      },
      simulateDelay: 120
    }
  },
  {
    id: 'pwp-health-ping',
    name: 'System Health Check GET /ping (200 OK)',
    endpoint: 'PING',
    description: 'Verify the operational health and reachability of the CLPWPE microservice gateway.',
    expectedStatus: 200,
    params: {
      authValid: true,
      simulateDelay: 65
    }
  }
];

export const ChaseApiConsole: React.FC = () => {
  const [selectedEndpoint, setSelectedEndpoint] = useState<EndpointKey>('POST_ENROLL');
  const [activeTab, setActiveTab] = useState<'params' | 'headers' | 'auth' | 'curl' | 'raw'>('params');

  // Input states
  const [accountUuid, setAccountUuid] = useState<string>('7e9c991a-8c54-41d9-9599-73e4b77f98b1');
  const [enrollmentTypeCode, setEnrollmentTypeCode] = useState<'AUTOENROLL' | 'ENROLL'>('AUTOENROLL');
  const [externalAccountIdentifier, setExternalAccountIdentifier] = useState<string>('CHASE-PRTNR-99482103');
  const [channelType, setChannelType] = useState<string>('MOBILE_NATIVE');
  const [authToken, setAuthToken] = useState<string>('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhcGkuY2hhc2UuY29tIiwic3ViIjoiQ0NPLU9BVVRILTIxMDA5MiIsImF1ZCI6ImNhcmQtbG95YWx0eS1zZXJ2aWNlIiwiZXhwIjoxNzg5MzAwMDAwLCJzY29wZSI6ImNhcmQifQ.Kj8_98u4nxN-SAMPLE-TOKEN');
  const [auth2Header, setAuth2Header] = useState<string>('2L-APP-CONTEXT:v1:CHASE-ENTERPRISE-SIGNATURE-773410');
  const [traceId, setTraceId] = useState<string>('');
  const [productCodeSelection, setProductCodeSelection] = useState<TransactionProductData['merchantDefinedProductCode']>('SAPPHIRE_RESERVE');

  // Response execution states
  const [isLoading, setIsLoading] = useState<boolean>(false);
  const [executionTimeMs, setExecutionTimeMs] = useState<number | null>(null);
  const [responseStatusCode, setResponseStatusCode] = useState<number | null>(null);
  const [responseHeaders, setResponseHeaders] = useState<Record<string, string> | null>(null);
  const [responseBody, setResponseBody] = useState<any>(null);
  const [copiedSection, setCopiedSection] = useState<string | null>(null);
  const [activePresetId, setActivePresetId] = useState<string>('pwp-autoenroll-sapphire');
  const [requestHistory, setRequestHistory] = useState<
    Array<{
      id: string;
      time: string;
      endpoint: EndpointKey;
      status: number;
      traceId: string;
      duration: number;
    }>
  >([]);

  // Generate random 128-bit hex trace-id on mount & refresh
  const generateNewTraceId = () => {
    const bytes = new Uint8Array(16);
    if (typeof window !== 'undefined' && window.crypto) {
      window.crypto.getRandomValues(bytes);
    } else {
      for (let i = 0; i < 16; i++) bytes[i] = Math.floor(Math.random() * 256);
    }
    return Array.from(bytes)
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  };

  const generateNewUuid = () => {
    if (typeof window !== 'undefined' && window.crypto?.randomUUID) {
      return window.crypto.randomUUID();
    }
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
      const r = (Math.random() * 16) | 0;
      const v = c === 'x' ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  };

  useEffect(() => {
    setTraceId(generateNewTraceId());
  }, []);

  const handleApplyPreset = (preset: ScenarioPreset) => {
    setActivePresetId(preset.id);
    setSelectedEndpoint(preset.endpoint);

    if (preset.params.uuid) setAccountUuid(preset.params.uuid);
    if (preset.params.enrollmentType) setEnrollmentTypeCode(preset.params.enrollmentType);
    if (preset.params.externalAccountId) setExternalAccountIdentifier(preset.params.externalAccountId);
    if (preset.params.channelType) setChannelType(preset.params.channelType);
    if (preset.params.productCode) setProductCodeSelection(preset.params.productCode);

    if (preset.params.authValid === false) {
      setAuthToken('INVALID_OR_EXPIRED_TOKEN_EXAMPLE_FAIL');
    } else {
      setAuthToken('eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhcGkuY2hhc2UuY29tIiwic3ViIjoiQ0NPLU9BVVRILTIxMDA5MiIsImF1ZCI6ImNhcmQtbG95YWx0eS1zZXJ2aWNlIiwiZXhwIjoxNzg5MzAwMDAwLCJzY29wZSI6ImNhcmQifQ.Kj8_98u4nxN-SAMPLE-TOKEN');
    }
  };

  const executeApiCall = () => {
    setIsLoading(true);
    const newReqTraceId = traceId || generateNewTraceId();
    setTraceId(newReqTraceId);

    const preset = PRESET_SCENARIOS.find((p) => p.id === activePresetId);
    const simulatedDelay = preset?.params.simulateDelay ?? (Math.floor(Math.random() * 150) + 120);

    setTimeout(() => {
      const now = new Date();
      const dateStr = now.toISOString().split('T')[0];
      let status = 200;
      let body: any = {};

      if (selectedEndpoint === 'PING') {
        status = 200;
        body = {
          status: 'UP',
          serviceName: 'Card Loyalty Pay With Points Enrollment Service (CLPWPE)',
          version: '1.0.0',
          gatewayNode: 'chase-prd-api-gw-us-east-04',
          healthTimestamp: now.toISOString(),
          upstreamStatus: {
            rewardsMRM: 'OPERATIONAL',
            authService: 'OPERATIONAL',
            customerMaster: 'OPERATIONAL'
          }
        };
      } else if (authToken.includes('INVALID') || !authToken.trim()) {
        status = 401;
        body = {
          errorDescription: 'Authorization Failure. Customer Token does not match. Customer will need to re-do the OAuth.',
          serviceErrorCode: 'AUTH_401_INVALID',
          externalErrorCode: 'OAUTH_TOKEN_REJECTED'
        };
      } else if (externalAccountIdentifier.includes('RESTRICTED') || activePresetId === 'pwp-err-409-ineligible') {
        status = 409;
        body = {
          errorDescription: 'List of business reasons: 601 : Account is not eligible for Pay with Points program.',
          serviceErrorCode: '601',
          externalErrorCode: 'ACCOUNT_NOT_ELIGIBLE'
        };
      } else if (selectedEndpoint === 'POST_ENROLL') {
        status = 200;
        body = {
          enrollment: {
            enrollmentStatusName: enrollmentTypeCode === 'AUTOENROLL' ? 'AUTOENROLLED' : 'ENROLLED',
            enrollmentStatusDate: dateStr
          },
          product: {
            merchantDefinedProductCode: productCodeSelection
          }
        };
      } else if (selectedEndpoint === 'PUT_UNENROLL') {
        status = 200;
        body = {
          enrollment: {
            enrollmentStatusName: 'UN-ENROLLED',
            enrollmentStatusDate: dateStr
          },
          product: {
            merchantDefinedProductCode: productCodeSelection
          }
        };
      }

      const headers: Record<string, string> = {
        'content-type': 'application/json; charset=utf-8',
        'trace-id': newReqTraceId,
        'x-chase-info': '24380//External///Product',
        'x-chase-gw-timestamp': now.toISOString(),
        'x-ratelimit-limit': '10000',
        'x-ratelimit-remaining': '9984',
        'access-control-allow-origin': '*',
        'cache-control': 'no-store, no-cache, must-revalidate',
        'strict-transport-security': 'max-age=31536000; includeSubDomains'
      };

      setResponseStatusCode(status);
      setResponseHeaders(headers);
      setResponseBody(body);
      setExecutionTimeMs(simulatedDelay);
      setIsLoading(false);

      setRequestHistory((prev) => [
        {
          id: Math.random().toString(36).substring(2, 9),
          time: now.toLocaleTimeString(),
          endpoint: selectedEndpoint,
          status,
          traceId: newReqTraceId,
          duration: simulatedDelay
        },
        ...prev.slice(0, 7)
      ]);
    }, simulatedDelay);
  };

  const copyToClipboard = (text: string, sectionKey: string) => {
    navigator.clipboard.writeText(text);
    setCopiedSection(sectionKey);
    setTimeout(() => setCopiedSection(null), 2000);
  };

  const currentPath =
    selectedEndpoint === 'PING'
      ? '/card/loyalty/earn-rewards/enrollment/v1/ping'
      : `/card/loyalty/earn-rewards/enrollment/v1/merchants/programs/pay-with-points/enrollments/${accountUuid}`;

  const currentCurl = `curl -X ${selectedEndpoint === 'PING' ? 'GET' : selectedEndpoint === 'POST_ENROLL' ? 'POST' : 'PUT'} \\
  "https://api.chase.com${currentPath}" \\
  -H "trace-id: ${traceId}" \\
  -H "authorization: Bearer ${authToken}" \\${
    selectedEndpoint !== 'PING'
      ? `
  -H "enrollment-type-code: ${enrollmentTypeCode}" \\
  -H "external-account-identifier: ${externalAccountIdentifier}" \\
  -H "channel-type: ${channelType}" \\
  -H "authorization2: ${auth2Header}" \\`
      : ''
  }
  -H "Accept: application/json"`;

  const getStatusColor = (code: number | null) => {
    if (!code) return 'bg-slate-800 text-slate-400 border-slate-700';
    if (code >= 200 && code < 300) return 'bg-emerald-950/80 text-emerald-300 border-emerald-500/50 shadow-emerald-950/50';
    if (code >= 400 && code < 500) return 'bg-amber-950/80 text-amber-300 border-amber-500/50 shadow-amber-950/50';
    return 'bg-rose-950/80 text-rose-300 border-rose-500/50 shadow-rose-950/50';
  };

  return (
    <div className="w-full bg-[#050C16] text-slate-100 rounded-2xl border border-blue-900/40 shadow-2xl overflow-hidden font-sans">
      {/* Header Banner */}
      <div className="bg-gradient-to-r from-[#0A192F] via-[#0D2644] to-[#0A192F] px-6 py-5 border-b border-blue-800/40 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center space-x-3.5">
          <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 p-0.5 shadow-lg shadow-blue-500/20 flex items-center justify-center">
            <div className="w-full h-full bg-[#071322] rounded-[10px] flex items-center justify-center">
              <Terminal className="w-5 h-5 text-blue-400" />
            </div>
          </div>
          <div>
            <div className="flex items-center space-x-2">
              <span className="text-xs font-bold tracking-widest uppercase text-blue-400">Swagger 2.0 Spec Sandbox</span>
              <span className="px-2 py-0.5 text-[10px] font-semibold bg-blue-500/10 text-blue-300 border border-blue-500/30 rounded-full">
                v1.0.0
              </span>
              <span className="px-2 py-0.5 text-[10px] font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 rounded-full flex items-center space-x-1">
                <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>api.chase.com</span>
              </span>
            </div>
            <h2 className="text-lg font-bold text-white tracking-tight">
              Pay With Points Enrollment API Console
            </h2>
          </div>
        </div>

        {/* Quick Presets Picker */}
        <div className="flex items-center space-x-2">
          <span className="text-xs text-slate-400 font-medium hidden sm:inline-flex items-center space-x-1">
            <Sparkles className="w-3.5 h-3.5 text-amber-400" />
            <span>Executive Presets:</span>
          </span>
          <select
            value={activePresetId}
            onChange={(e) => {
              const found = PRESET_SCENARIOS.find((p) => p.id === e.target.value);
              if (found) handleApplyPreset(found);
            }}
            className="bg-[#0c1e36] text-xs font-medium text-blue-200 border border-blue-700/50 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500 hover:border-blue-500 transition-all cursor-pointer"
          >
            {PRESET_SCENARIOS.map((scenario) => (
              <option key={scenario.id} value={scenario.id} className="bg-[#0a182b] text-white">
                [{scenario.expectedStatus}] {scenario.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      {/* Preset summary callout */}
      {(() => {
        const activePreset = PRESET_SCENARIOS.find((p) => p.id === activePresetId);
        if (!activePreset) return null;
        return (
          <div className="bg-blue-950/30 border-b border-blue-900/30 px-6 py-2.5 flex items-center justify-between text-xs text-slate-300">
            <div className="flex items-center space-x-2 overflow-hidden text-ellipsis">
              <span className="font-semibold text-blue-300">Scenario Target:</span>
              <span className="text-slate-200 truncate">{activePreset.description}</span>
            </div>
            <span className="text-[11px] font-mono text-blue-400/80 shrink-0 ml-4">
              Expected HTTP {activePreset.expectedStatus}
            </span>
          </div>
        );
      })()}

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-0">
        {/* Left Column: Request Builder */}
        <div className="lg:col-span-7 border-b lg:border-b-0 lg:border-r border-blue-900/30 p-6 space-y-6">
          {/* Method and URL Bar */}
          <div className="space-y-2">
            <label className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
              <span>Endpoint Route</span>
              <span className="text-[11px] font-normal text-blue-400 font-mono">2-Legged OAuth Scopes: [card]</span>
            </label>
            <div className="flex flex-col sm:flex-row items-stretch sm:items-center bg-[#071322] border border-blue-900/50 rounded-xl overflow-hidden p-1 gap-1 focus-within:ring-2 focus-within:ring-blue-500/50">
              <div className="flex shrink-0">
                <button
                  type="button"
                  onClick={() => setSelectedEndpoint('POST_ENROLL')}
                  className={`px-3 py-1.5 rounded-lg text-xs font-black tracking-wider transition-all ${
                    selectedEndpoint === 'POST_ENROLL'
                      ? 'bg-blue-600 text-white shadow-md'
                      : 'text-slate-400 hover:text-white hover:bg-blue-950/50'
                  }`}
                >
                  POST Enroll
                </button>
                <button
                  type="button"
                  onClick={() => setSelectedEndpoint('PUT_UNENROLL')}
                  className={`px-3 py-1.5 rounded-lg text-xs font-black tracking-wider transition-all ${
                    selectedEndpoint === 'PUT_UNENROLL'
                      ? 'bg-amber-600 text-white shadow-md'
                      : 'text-slate-400 hover:text-white hover:bg-amber-950/50'
                  }`}
                >
                  PUT Un-Enroll
                </button>
                <button
                  type="button"
                  onClick={() => setSelectedEndpoint('PING')}
                  className={`px-3 py-1.5 rounded-lg text-xs font-black tracking-wider transition-all ${
                    selectedEndpoint === 'PING'
                      ? 'bg-emerald-600 text-white shadow-md'
                      : 'text-slate-400 hover:text-white hover:bg-emerald-950/50'
                  }`}
                >
                  GET Ping
                </button>
              </div>
              <div className="flex-1 font-mono text-xs text-blue-200 px-3 py-2 overflow-x-auto whitespace-nowrap bg-black/30 rounded-lg">
                <span className="text-slate-500 font-sans">https://api.chase.com</span>
                {currentPath}
              </div>
              <button
                type="button"
                onClick={executeApiCall}
                disabled={isLoading}
                className="inline-flex items-center justify-center space-x-2 bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white font-bold text-xs px-5 py-2.5 rounded-lg shadow-lg shadow-blue-600/30 active:scale-95 transition-all disabled:opacity-50 shrink-0"
              >
                {isLoading ? (
                  <>
                    <Activity className="w-4 h-4 animate-spin text-white" />
                    <span>Executing...</span>
                  </>
                ) : (
                  <>
                    <Send className="w-3.5 h-3.5" />
                    <span>Send Request</span>
                  </>
                )}
              </button>
            </div>
          </div>

          {/* Tab Navigation */}
          <div className="border-b border-blue-950">
            <nav className="flex space-x-4">
              <button
                type="button"
                onClick={() => setActiveTab('params')}
                className={`pb-2 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 transition-all border-b-2 ${
                  activeTab === 'params'
                    ? 'border-blue-400 text-blue-400'
                    : 'border-transparent text-slate-400 hover:text-slate-200'
                }`}
              >
                <Sliders className="w-3.5 h-3.5" />
                <span>Parameters & Body</span>
              </button>
              <button
                type="button"
                onClick={() => setActiveTab('headers')}
                className={`pb-2 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 transition-all border-b-2 ${
                  activeTab === 'headers'
                    ? 'border-blue-400 text-blue-400'
                    : 'border-transparent text-slate-400 hover:text-slate-200'
                }`}
              >
                <Layers className="w-3.5 h-3.5" />
                <span>Chase Headers</span>
              </button>
              <button
                type="button"
                onClick={() => setActiveTab('auth')}
                className={`pb-2 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 transition-all border-b-2 ${
                  activeTab === 'auth'
                    ? 'border-blue-400 text-blue-400'
                    : 'border-transparent text-slate-400 hover:text-slate-200'
                }`}
              >
                <Lock className="w-3.5 h-3.5" />
                <span>OAuth 2.0 Auth</span>
              </button>
              <button
                type="button"
                onClick={() => setActiveTab('curl')}
                className={`pb-2 text-xs font-bold uppercase tracking-wider flex items-center space-x-1.5 transition-all border-b-2 ${
                  activeTab === 'curl'
                    ? 'border-blue-400 text-blue-400'
                    : 'border-transparent text-slate-400 hover:text-slate-200'
                }`}
              >
                <Code2 className="w-3.5 h-3.5" />
                <span>cURL Snippet</span>
              </button>
            </nav>
          </div>

          {/* Tab 1: Parameters */}
          {activeTab === 'params' && (
            <div className="space-y-4 text-xs">
              {selectedEndpoint === 'PING' ? (
                <div className="p-5 rounded-xl bg-slate-900/50 border border-slate-800 text-slate-400 space-y-2">
                  <div className="flex items-center space-x-2 text-emerald-400 font-semibold">
                    <CheckCircle2 className="w-4 h-4" />
                    <span>No Path or Body Parameters Required</span>
                  </div>
                  <p className="text-slate-400">
                    The <code className="text-blue-300 font-mono">/ping</code> health check route requires zero parameters and returns HTTP 200 OK with gateway verification timestamp.
                  </p>
                </div>
              ) : (
                <>
                  <div className="space-y-1.5">
                    <div className="flex items-center justify-between">
                      <label className="font-semibold text-slate-300 flex items-center space-x-1.5">
                        <span className="text-rose-400">*</span>
                        <span>account-reference-universal-unique-identifier</span>
                        <span className="text-[10px] px-1.5 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/40">
                          path : UUID
                        </span>
                      </label>
                      <button
                        type="button"
                        onClick={() => setAccountUuid(generateNewUuid())}
                        className="text-[11px] text-blue-400 hover:text-blue-300 font-medium flex items-center space-x-1"
                      >
                        <RotateCcw className="w-3 h-3" />
                        <span>Regenerate UUID</span>
                      </button>
                    </div>
                    <input
                      type="text"
                      value={accountUuid}
                      onChange={(e) => setAccountUuid(e.target.value)}
                      className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-100 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none"
                    />
                    <p className="text-[11px] text-slate-500">
                      128-bit persistent UUID generated to identify card account during checkout trades (length 36 chars).
                    </p>
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div className="space-y-1.5">
                      <label className="font-semibold text-slate-300 flex items-center space-x-1.5">
                        <span className="text-rose-400">*</span>
                        <span>enrollment-type-code</span>
                        <span className="text-[10px] px-1.5 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/40">
                          header : enum
                        </span>
                      </label>
                      <select
                        value={enrollmentTypeCode}
                        onChange={(e) => setEnrollmentTypeCode(e.target.value as any)}
                        className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-100 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer"
                      >
                        <option value="AUTOENROLL">AUTOENROLL (Default Frictionless)</option>
                        <option value="ENROLL">ENROLL (Customer Self-Initiated)</option>
                      </select>
                    </div>

                    <div className="space-y-1.5">
                      <label className="font-semibold text-slate-300 flex items-center space-x-1.5">
                        <span className="text-blue-400">Target Card Product (MRM)</span>
                      </label>
                      <select
                        value={productCodeSelection}
                        onChange={(e) => setProductCodeSelection(e.target.value as any)}
                        className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-100 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer"
                      >
                        <option value="SAPPHIRE_RESERVE">SAPPHIRE_RESERVE ($550/yr Top Tier)</option>
                        <option value="JPM_RESERVE">JPM_RESERVE (Private Bank)</option>
                        <option value="SAPPHIRE_PREFERRED">SAPPHIRE_PREFERRED (Mid Tier)</option>
                        <option value="INK_BUSINESS_PREFERRED">INK_BUSINESS_PREFERRED (Commercial)</option>
                        <option value="INK_BUSINESS_UNLIMITED">INK_BUSINESS_UNLIMITED</option>
                        <option value="FREEDOM_UNLIMITED">FREEDOM_UNLIMITED (1.5% Unlimited)</option>
                        <option value="FREEDOM">FREEDOM (5% Rotating)</option>
                        <option value="SLATE">SLATE (Zero Fee Basic)</option>
                      </select>
                    </div>
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div className="space-y-1.5">
                      <label className="font-semibold text-slate-300 flex items-center space-x-1.5">
                        <span className="text-rose-400">*</span>
                        <span>external-account-identifier</span>
                      </label>
                      <input
                        type="text"
                        maxLength={32}
                        value={externalAccountIdentifier}
                        onChange={(e) => setExternalAccountIdentifier(e.target.value)}
                        className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-100 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none"
                      />
                    </div>

                    <div className="space-y-1.5">
                      <label className="font-semibold text-slate-300">channel-type</label>
                      <select
                        value={channelType}
                        onChange={(e) => setChannelType(e.target.value)}
                        className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-100 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer"
                      >
                        <option value="MOBILE_NATIVE">MOBILE_NATIVE (iOS / Android App)</option>
                        <option value="WEB">WEB (Desktop Merchant Portal)</option>
                        <option value="MOBILE_WEB">MOBILE_WEB (Responsive Mobile Browser)</option>
                        <option value="POS_TERMINAL">POS_TERMINAL (In-Store Physical POS)</option>
                      </select>
                    </div>
                  </div>
                </>
              )}
            </div>
          )}

          {/* Tab 2: Chase Headers */}
          {activeTab === 'headers' && (
            <div className="space-y-3.5 text-xs">
              <div className="space-y-1.5">
                <div className="flex items-center justify-between">
                  <label className="font-semibold text-slate-300 flex items-center space-x-1.5">
                    <span className="text-rose-400">*</span>
                    <span>trace-id</span>
                    <span className="text-[10px] px-1.5 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/40">
                      128-bit Hex
                    </span>
                  </label>
                  <button
                    type="button"
                    onClick={() => setTraceId(generateNewTraceId())}
                    className="text-[11px] text-blue-400 hover:text-blue-300 font-medium flex items-center space-x-1"
                  >
                    <RotateCcw className="w-3 h-3" />
                    <span>New Hex Trace</span>
                  </button>
                </div>
                <input
                  type="text"
                  maxLength={32}
                  value={traceId}
                  onChange={(e) => setTraceId(e.target.value)}
                  className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-amber-300 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none"
                />
                <p className="text-[11px] text-slate-500">
                  Mandatory enterprise trace ID for auditability, telemetry correlation, and downstream MRM loyalty logs.
                </p>
              </div>

              <div className="space-y-1.5">
                <label className="font-semibold text-slate-300 flex items-center space-x-1.5">
                  <span>authorization2</span>
                  <span className="text-[10px] px-1.5 py-0.5 rounded bg-slate-900 text-slate-400">Optional / 3-Legged</span>
                </label>
                <input
                  type="text"
                  value={auth2Header}
                  onChange={(e) => setAuth2Header(e.target.value)}
                  className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-100 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none"
                />
              </div>

              <div className="p-3 bg-[#081524]/60 border border-blue-900/40 rounded-lg text-slate-400 text-[11px] space-y-1">
                <span className="font-semibold text-blue-300">Standard Chase Gateway Headers auto-attached:</span>
                <div className="font-mono text-slate-400 grid grid-cols-2 gap-1 pt-1">
                  <div>Accept: application/json</div>
                  <div>Content-Type: application/json</div>
                  <div>x-chase-info: 24380//External///Product</div>
                  <div>Host: api.chase.com</div>
                </div>
              </div>
            </div>
          )}

          {/* Tab 3: OAuth Authentication */}
          {activeTab === 'auth' && (
            <div className="space-y-4 text-xs">
              <div className="p-3.5 bg-blue-950/40 border border-blue-800/50 rounded-xl space-y-2">
                <div className="flex items-center space-x-2 text-blue-300 font-bold">
                  <ShieldCheck className="w-4 h-4 text-emerald-400" />
                  <span>Common 2-Legged OAuth (Application Flow)</span>
                </div>
                <p className="text-slate-300 text-[11px] leading-relaxed">
                  Token endpoint: <code className="text-amber-300 font-mono">https://api-sandbox.chase.com/ccoauth/token</code>
                  <br />Required OAuth Scope: <code className="text-emerald-300 font-mono">card</code>
                </p>
              </div>

              <div className="space-y-1.5">
                <div className="flex items-center justify-between">
                  <label className="font-semibold text-slate-300">authorization (Bearer Token)</label>
                  <button
                    type="button"
                    onClick={() =>
                      setAuthToken(
                        'eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhcGkuY2hhc2UuY29tIiwic3ViIjoiQ0NPLU9BVVRILTIxMDA5MiIsImF1ZCI6ImNhcmQtbG95YWx0eS1zZXJ2aWNlIiwiZXhwIjoxNzg5MzAwMDAwLCJzY29wZSI6ImNhcmQifQ.Kj8_98u4nxN-SAMPLE-TOKEN'
                      )
                    }
                    className="text-[11px] text-blue-400 hover:text-blue-300"
                  >
                    Reset Valid Token
                  </button>
                </div>
                <textarea
                  rows={3}
                  value={authToken}
                  onChange={(e) => setAuthToken(e.target.value)}
                  className="w-full bg-[#081524] border border-blue-900/60 rounded-lg px-3.5 py-2 text-blue-200 font-mono text-xs focus:ring-2 focus:ring-blue-500 outline-none resize-none"
                />
              </div>
            </div>
          )}

          {/* Tab 4: cURL */}
          {activeTab === 'curl' && (
            <div className="space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-xs text-slate-400 font-semibold">Ready-to-run Terminal cURL Command:</span>
                <button
                  type="button"
                  onClick={() => copyToClipboard(currentCurl, 'curl')}
                  className="inline-flex items-center space-x-1 text-xs text-blue-400 hover:text-blue-300"
                >
                  {copiedSection === 'curl' ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                  <span>{copiedSection === 'curl' ? 'Copied!' : 'Copy cURL'}</span>
                </button>
              </div>
              <pre className="p-4 bg-black/60 rounded-xl border border-blue-900/40 text-blue-300 font-mono text-[11px] overflow-x-auto leading-relaxed whitespace-pre-wrap">
                {currentCurl}
              </pre>
            </div>
          )}
        </div>

        {/* Right Column: Interactive Response Console */}
        <div className="lg:col-span-5 bg-[#030912] p-6 flex flex-col justify-between space-y-6">
          <div className="space-y-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Live Response Payload</span>
                {executionTimeMs !== null && (
                  <span className="text-[11px] text-slate-400 font-mono flex items-center space-x-1 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
                    <Clock className="w-3 h-3 text-blue-400" />
                    <span>{executionTimeMs}ms</span>
                  </span>
                )}
              </div>

              {responseStatusCode && (
                <div
                  className={`px-3 py-1 rounded-lg text-xs font-black font-mono border shadow-md flex items-center space-x-1.5 ${getStatusColor(
                    responseStatusCode
                  )}`}
                >
                  {responseStatusCode >= 200 && responseStatusCode < 300 ? (
                    <CheckCircle2 className="w-3.5 h-3.5" />
                  ) : (
                    <AlertTriangle className="w-3.5 h-3.5" />
                  )}
                  <span>HTTP {responseStatusCode}</span>
                </div>
              )}
            </div>

            {/* Response Display Box */}
            <div className="relative rounded-xl border border-blue-900/50 bg-[#06111f] overflow-hidden min-h-[280px]">
              {isLoading ? (
                <div className="absolute inset-0 flex flex-col items-center justify-center space-y-3 bg-[#06111f]/90 backdrop-blur-sm z-10">
                  <div className="w-10 h-10 border-2 border-blue-500 border-t-transparent rounded-full animate-spin" />
                  <span className="text-xs font-mono text-blue-300 animate-pulse">Contacting Chase CLPWPE Gateway...</span>
                </div>
              ) : null}

              {responseBody ? (
                <div>
                  <div className="flex items-center justify-between px-3.5 py-2 bg-[#0a1b30] border-b border-blue-900/40 text-[11px]">
                    <span className="font-mono text-blue-300">application/json</span>
                    <div className="flex items-center space-x-2">
                      <button
                        type="button"
                        onClick={() => copyToClipboard(JSON.stringify(responseBody, null, 2), 'response')}
                        className="inline-flex items-center space-x-1 text-slate-400 hover:text-white"
                      >
                        {copiedSection === 'response' ? (
                          <Check className="w-3 h-3 text-emerald-400" />
                        ) : (
                          <Copy className="w-3 h-3" />
                        )}
                        <span>{copiedSection === 'response' ? 'Copied' : 'Copy'}</span>
                      </button>
                    </div>
                  </div>
                  <pre className="p-4 text-xs font-mono text-emerald-400 overflow-x-auto max-h-[320px] leading-relaxed select-all">
                    {JSON.stringify(responseBody, null, 2)}
                  </pre>
                </div>
              ) : (
                <div className="flex flex-col items-center justify-center p-12 text-center text-slate-500 space-y-3">
                  <Terminal className="w-8 h-8 text-blue-500/30" />
                  <div className="space-y-1">
                    <p className="text-xs font-medium text-slate-400">Console is idle.</p>
                    <p className="text-[11px] text-slate-600">Select a preset or click &quot;Send Request&quot; to test the real Swagger API contract.</p>
                  </div>
                </div>
              )}
            </div>

            {/* Response Headers Accordion */}
            {responseHeaders && (
              <details className="text-xs bg-[#081524] rounded-lg border border-blue-900/40 p-3 group">
                <summary className="font-semibold text-slate-300 cursor-pointer flex items-center justify-between hover:text-blue-300">
                  <span>Response Headers ({Object.keys(responseHeaders).length})</span>
                  <span className="text-[10px] text-blue-400 group-open:rotate-90 transition-transform">▸</span>
                </summary>
                <div className="mt-2.5 pt-2.5 border-t border-blue-900/30 font-mono text-[11px] space-y-1 text-slate-400">
                  {Object.entries(responseHeaders).map(([k, v]) => (
                    <div key={k} className="flex justify-between">
                      <span className="text-blue-400">{k}:</span>
                      <span className="text-slate-200 truncate ml-2 max-w-[220px]" title={v}>
                        {v}
                      </span>
                    </div>
                  ))}
                </div>
              </details>
            )}
          </div>

          {/* Audit History Log */}
          {requestHistory.length > 0 && (
            <div className="space-y-2 pt-2 border-t border-blue-950">
              <div className="flex items-center justify-between text-[11px] text-slate-400">
                <span className="font-semibold uppercase tracking-wider">Session Audit Trail</span>
                <span>{requestHistory.length} calls</span>
              </div>
              <div className="space-y-1.5">
                {requestHistory.map((item) => (
                  <div
                    key={item.id}
                    className="flex items-center justify-between bg-[#081628]/70 border border-blue-900/30 rounded px-2.5 py-1.5 text-[11px] font-mono"
                  >
                    <div className="flex items-center space-x-2">
                      <span
                        className={`px-1.5 py-0.2 rounded font-bold text-[10px] ${
                          item.status === 200 ? 'bg-emerald-950 text-emerald-400' : 'bg-rose-950 text-rose-400'
                        }`}
                      >
                        {item.status}
                      </span>
                      <span className="text-slate-300 font-semibold">{item.endpoint}</span>
                    </div>
                    <div className="flex items-center space-x-2 text-slate-500">
                      <span className="truncate max-w-[70px]" title={item.traceId}>
                        #{item.traceId.substring(0, 6)}
                      </span>
                      <span className="text-slate-400">{item.duration}ms</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default ChaseApiConsole;
components/chase/ChaseArchitectureHub.tsx
           <span className="font-bold text-white tracking-wide">Enterprise CLPWPE Architecture Hub</span>
            <span className="text-xs text-slate-400">Global Microservices & High-Volume Topology</span>
          </div>
        </div>

        {/* Global Controls */}
        <div className="flex flex-wrap items-center gap-3">
          <button
            onClick={() => setIsSimulating(!isSimulating)}
            className={`flex items-center space-x-2 px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all border ${
              isSimulating
                ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40 shadow-lg shadow-emerald-900/20'
                : 'bg-slate-800 text-slate-400 border-slate-700 hover:text-slate-200'
            }`}
          >
            <Activity className={`w-3.5 h-3.5 ${isSimulating ? 'animate-spin' : ''}`} />
            <span>{isSimulating ? 'Live Telemetry Active' : 'Simulation Paused'}</span>
          </button>

          <div className="flex items-center space-x-1 bg-slate-900 p-1 rounded-lg border border-slate-800">
            {(['topology', 'metrics', 'spec'] as const).map((view) => (
              <button
                key={view}
                onClick={() => setSelectedView(view)}
                className={`px-3 py-1 text-xs font-semibold rounded-md transition-all uppercase tracking-wider ${
                  selectedView === view
                    ? 'bg-blue-600 text-white shadow'
                    : 'text-slate-400 hover:text-white'
                }`}
              >
                {view}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Main View Area */}
      <div className="p-6">
        {selectedView === 'topology' && (
          <div className="space-y-6">
            {/* Top Flow Pipeline Diagram */}
            <div className="bg-slate-900/80 border border-slate-800 rounded-xl p-5 shadow-inner">
              <div className="flex items-center justify-between mb-4">
                <span className="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center space-x-2">
                  <Layers className="w-4 h-4 text-blue-400" />
                  <span>End-to-End Execution Sequence</span>
                </span>
                <span className="text-xs text-blue-400 font-mono">TLS 1.3 | mTLS Inside Perimeter</span>
              </div>

              {/* Pipeline Nodes */}
              <div className="grid grid-cols-1 md:grid-cols-5 gap-3 relative">
                {ARCHITECTURE_NODES.map((node, idx) => {
                  const isSelected = activeNode.id === node.id;
                  return (
                    <div
                      key={node.id}
                      onClick={() => setActiveNode(node)}
                      className={`relative cursor-pointer rounded-xl p-4 transition-all duration-200 border text-left ${
                        isSelected
                          ? 'bg-blue-950/60 border-blue-400 shadow-lg shadow-blue-900/30 scale-[1.02]'
                          : 'bg-slate-950/70 border-slate-800 hover:border-slate-700'
                      }`}
                    >
                      <div className="flex items-center justify-between mb-2">
                        <span className="w-6 h-6 rounded-full bg-slate-800 text-[11px] font-bold text-slate-300 flex items-center justify-center">
                          {idx + 1}
                        </span>
                        <span
                          className={`w-2 h-2 rounded-full ${
                            node.status === 'healthy' ? 'bg-emerald-400 animate-pulse' : 'bg-amber-400'
                          }`}
                        />
                      </div>
                      <div className="font-bold text-sm text-white truncate">{node.name}</div>
                      <div className="text-[11px] text-slate-400 mt-1 line-clamp-2">{node.role}</div>
                      <div className="mt-3 pt-2 border-t border-slate-800/80 flex items-center justify-between text-[10px] text-slate-400 font-mono">
                        <span>{node.latency}</span>
                        <span className="text-emerald-400">{node.throughput}</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Node Deep Dive Details */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* Selected Node Inspector */}
              <div className="lg:col-span-2 bg-slate-900/60 border border-slate-800 rounded-xl p-6 space-y-4">
                <div className="flex items-center justify-between border-b border-slate-800 pb-4">
                  <div>
                    <span className="text-xs uppercase font-mono text-blue-400 font-bold">Node Inspector</span>
                    <h3 className="text-xl font-bold text-white mt-0.5">{activeNode.name}</h3>
                  </div>
                  <span className="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 uppercase tracking-wider">
                    {activeNode.status}
                  </span>
                </div>

                <p className="text-slate-300 text-sm leading-relaxed">{activeNode.description}</p>

                {/* Sub-components list */}
                <div className="space-y-2">
                  <span className="text-xs font-bold uppercase tracking-wider text-slate-400">Integrated Micro-Engines</span>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {activeNode.subcomponents.map((sub, i) => (
                      <div key={i} className="flex items-center space-x-2 bg-slate-950 p-2.5 rounded-lg border border-slate-800/60 text-xs">
                        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400 shrink-0" />
                        <span className="text-slate-200">{sub}</span>
                      </div>
                    ))}
                  </div>
                </div>

                {/* Live Node Metrics */}
                <div className="grid grid-cols-3 gap-3 pt-3 border-t border-slate-800">
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 text-center">
                    <span className="text-[10px] uppercase font-mono text-slate-500">Latency P99</span>
                    <div className="text-base font-mono font-bold text-blue-400 mt-0.5">{activeNode.latency}</div>
                  </div>
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 text-center">
                    <span className="text-[10px] uppercase font-mono text-slate-500">Throughput</span>
                    <div className="text-base font-mono font-bold text-emerald-400 mt-0.5">{activeNode.throughput}</div>
                  </div>
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 text-center">
                    <span className="text-[10px] uppercase font-mono text-slate-500">SLA Target</span>
                    <div className="text-base font-mono font-bold text-amber-300 mt-0.5">99.999%</div>
                  </div>
                </div>
              </div>

              {/* Realtime Telemetry Feed */}
              <div className="bg-slate-900/60 border border-slate-800 rounded-xl p-5 space-y-4">
                <div className="flex items-center justify-between border-b border-slate-800 pb-3">
                  <div className="flex items-center space-x-2 text-xs font-bold text-slate-300 uppercase tracking-wider">
                    <Terminal className="w-4 h-4 text-emerald-400" />
                    <span>Real-time Gateway Logs</span>
                  </div>
                  <span className="w-2 h-2 rounded-full bg-emerald-400 animate-ping" />
                </div>

                <div className="space-y-2 font-mono text-[11px] max-h-72 overflow-y-auto pr-1">
                  {logs.map((log) => (
                    <div
                      key={log.id}
                      className="bg-slate-950/80 p-2.5 rounded border border-slate-800/80 space-y-1 hover:border-slate-700 transition"
                    >
                      <div className="flex items-center justify-between text-slate-500 text-[10px]">
                        <span>{log.time}</span>
                        <span className={`font-bold ${log.status === 200 ? 'text-emerald-400' : 'text-amber-400'}`}>
                          HTTP {log.status}
                        </span>
                      </div>
                      <div className="text-slate-300 flex items-center space-x-2">
                        <span className="text-blue-400 font-bold">{log.method}</span>
                        <span className="truncate">{log.route}</span>
                      </div>
                      <div className="text-slate-500 text-[10px] flex items-center justify-between">
                        <span>trace:{log.trace.substring(0, 10)}...</span>
                        <span className="text-slate-400">{log.latency}ms</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

        {selectedView === 'metrics' && (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div className="bg-slate-900/70 border border-slate-800 rounded-xl p-5 space-y-2">
              <div className="flex items-center justify-between text-slate-400">
                <span className="text-xs uppercase font-mono font-bold">Total Daily Invocations</span>
                <Globe className="w-4 h-4 text-blue-400" />
              </div>
              <div className="text-2xl font-bold font-mono text-white">48,291,040</div>
              <span className="text-xs text-emerald-400 font-medium">+14.2% week-over-week</span>
            </div>

            <div className="bg-slate-900/70 border border-slate-800 rounded-xl p-5 space-y-2">
              <div className="flex items-center justify-between text-slate-400">
                <span className="text-xs uppercase font-mono font-bold">Average Latency P95</span>
                <Clock className="w-4 h-4 text-emerald-400" />
              </div>
              <div className="text-2xl font-bold font-mono text-emerald-300">38.4 ms</div>
              <span className="text-xs text-slate-400">Global multi-region edge cache</span>
            </div>

            <div className="bg-slate-900/70 border border-slate-800 rounded-xl p-5 space-y-2">
              <div className="flex items-center justify-between text-slate-400">
                <span className="text-xs uppercase font-mono font-bold">OAuth Auth Verification</span>
                <ShieldCheck className="w-4 h-4 text-indigo-400" />
              </div>
              <div className="text-2xl font-bold font-mono text-indigo-300">100.0%</div>
              <span className="text-xs text-slate-400">Zero unauthorized perimeter breaches</span>
            </div>

            <div className="bg-slate-900/70 border border-slate-800 rounded-xl p-5 space-y-2">
              <div className="flex items-center justify-between text-slate-400">
                <span className="text-xs uppercase font-mono font-bold">Error Rate (4xx/5xx)</span>
                <AlertCircle className="w-4 h-4 text-amber-400" />
              </div>
              <div className="text-2xl font-bold font-mono text-amber-300">0.008%</div>
              <span className="text-xs text-emerald-400">Exceeds 5-Nines reliability SLA</span>
            </div>
          </div>
        )}

        {selectedView === 'spec' && (
          <div className="bg-slate-900/80 border border-slate-800 rounded-xl p-6 space-y-4">
            <div className="flex items-center justify-between border-b border-slate-800 pb-3">
              <div className="flex items-center space-x-2 text-sm font-bold text-white">
                <FileCode className="w-4 h-4 text-blue-400" />
                <span>Swagger 2.0 Spec Digest</span>
              </div>
              <span className="text-xs font-mono text-slate-400">api.chase.com/card/loyalty/earn-rewards/enrollment/v1</span>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
              <div className="bg-slate-950 p-4 rounded-lg border border-slate-800 space-y-2">
                <span className="text-emerald-400 font-bold">GET /ping</span>
                <p className="text-slate-400 font-sans text-xs">Diagnostic health check probe verifying edge gateway availability and downstream ledger health.</p>
                <div className="text-[10px] text-slate-500">Responses: 200 OK, 500, 504</div>
              </div>

              <div className="bg-slate-950 p-4 rounded-lg border border-slate-800 space-y-2">
                <span className="text-blue-400 font-bold">POST /merchants/.../enrollments/{'{uuid}'}</span>
                <p className="text-slate-400 font-sans text-xs">Enrolls cardholder into Pay with Points program. Handles AUTOENROLL and ENROLL semantics.</p>
                <div className="text-[10px] text-slate-500">Responses: 200, 400, 401, 404, 409, 422, 500, 502, 503</div>
              </div>

              <div className="bg-slate-950 p-4 rounded-lg border border-slate-800 space-y-2">
                <span className="text-amber-400 font-bold">PUT /merchants/.../enrollments/{'{uuid}'}</span>
                <p className="text-slate-400 font-sans text-xs">Un-enrolls or opts out cardholder from the Pay with Points redemption facility.</p>
                <div className="text-[10px] text-slate-500">Responses: 200, 400, 401, 403, 404, 409, 422, 500, 502, 503</div>
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Footer System Status Bar */}
      <div className="bg-slate-950 px-6 py-3 border-t border-slate-800 flex flex-wrap items-center justify-between text-xs text-slate-400 gap-2">
        <div className="flex items-center space-x-3">
          <span className="flex items-center space-x-1 text-emerald-400">
            <CheckCircle2 className="w-3.5 h-3.5" />
            <span>All 5 Microservice Clusters Fully Operational</span>
          </span>
          <span className="text-slate-600">|</span>
          <span>Region: us-east-1 (Primary), us-west-2 (Failover Hot-Standby)</span>
        </div>
        <div className="font-mono text-slate-500 text-[11px]">
          FIPS 140-2 Level 3 HSM Enclave Active
        </div>
      </div>
    </div>
  );
};

export default ChaseArchitectureHub;
import React, { useState, useEffect } from 'react';
import {
  Server,
  ShieldCheck,
  Zap,
  ArrowRight,
  Database,
  RefreshCw,
  Layers,
  Globe,
