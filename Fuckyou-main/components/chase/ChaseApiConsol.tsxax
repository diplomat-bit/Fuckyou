  AlertCircle,
  Clock,
  Key,
  FileCode
} from 'lucide-react';

interface ArchitectureNode {
  id: string;
  name: string;
  role: string;
  status: 'healthy' | 'warning' | 'degraded';
  latency: string;
  throughput: string;
  description: string;
  subcomponents: string[];
}

const ARCHITECTURE_NODES: ArchitectureNode[] = [
  {
    id: 'partner-app',
    name: 'Partner Digital Channel',
    role: 'Merchant Web / Mobile App Client',
    status: 'healthy',
    latency: '8ms',
    throughput: '14,200 req/s',
    description: 'Initiates 2-Legged OAuth payload, attaches 128-bit trace-id, and sends REST payloads for auto-enrollment and un-enrollment.',
    subcomponents: ['iOS / Android SDK', 'Checkout PWP Button', 'Session State Store', 'UUID Generator']
  },
  {
    id: 'api-gateway',
    name: 'Chase API Gateway',
    role: 'Perimeter Security & Ingress Router',
    status: 'healthy',
    latency: '4ms',
    throughput: '98,000 req/s',
    description: 'Enforces rate limits, TLS 1.3 termination, header sanitation, trace ID auditing, and routes to the CLPWPE microservice cluster.',
    subcomponents: ['Kong/Apigee Hybrid Ingress', 'Rate Limiter (Token Bucket)', 'WAF & DDoS Shield', 'Header Validator']
  },
  {
    id: 'auth-service',
    name: 'Authentication Service',
    role: '2-Legged & 3-Legged OAuth Token Broker',
    status: 'healthy',
    latency: '11ms',
    throughput: '22,400 val/s',
    description: 'Validates OAuth bearer tokens via https://api-sandbox.chase.com/ccoauth/token with "card" scope and authorizes enterprise partner signatures.',
    subcomponents: ['JWT Introspection Engine', 'Scope Authority (card)', 'HSM Signature Key Store', 'Replay Attack Prevention']
  },
  {
    id: 'clpwpe-core',
    name: 'CLPWPE Service Engine',
    role: 'Card Loyalty Pay With Points Engine',
    status: 'healthy',
    latency: '18ms',
    throughput: '31,500 ops/s',
    description: 'Executes core loyalty business rules, validates RPC product codes (Sapphire, Freedom, Ink, Slate), and orchestrates enrollment status shifts.',
    subcomponents: ['Eligibility Rule Engine', 'State Transition Machine', 'Audit Trail Dispatcher', 'Idempotency Cache']
  },
  {
    id: 'mrm-ledger',
    name: 'Merchant Relationship & Points Ledger',
    role: 'Downstream Ultimate Rewards Core',
    status: 'healthy',
    latency: '24ms',
    throughput: '19,000 tx/s',
    description: 'Maintains universal account mappings, calculates real-time point-to-dollar valuation rates, and commits immutable loyalty participation ledgers.',
    subcomponents: ['Ultimate Rewards Core', 'UUID-to-PAN Vault (PCI-DSS)', 'Product Catalog (RPC)', 'Real-time Points Balancer']
  }
];

export const ChaseArchitectureHub: React.FC = () => {
  const [activeNode, setActiveNode] = useState<ArchitectureNode>(ARCHITECTURE_NODES[0]);
  const [selectedView, setSelectedView] = useState<'topology' | 'metrics' | 'spec'>('topology');
  const [isSimulating, setIsSimulating] = useState<boolean>(true);
  const [logs, setLogs] = useState<
    Array<{ id: string; time: string; method: string; route: string; status: number; latency: number; trace: string }>
  >([]);

  // Simulated traffic log generator
  useEffect(() => {
    if (!isSimulating) return;

    const interval = setInterval(() => {
      const routes = [
        { method: 'POST', path: '/merchants/programs/pay-with-points/enrollments/7e9c991a-8c54-41d9', status: 200 },
        { method: 'GET', path: '/ping', status: 200 },
        { method: 'PUT', path: '/merchants/programs/pay-with-points/enrollments/3a18e032-478a-4d2b', status: 200 },
        { method: 'POST', path: '/merchants/programs/pay-with-points/enrollments/99bf0a2c-f601-4475', status: 409 },
      ];
      const randomRoute = routes[Math.floor(Math.random() * routes.length)];
      const randomLatency = Math.floor(Math.random() * 45) + 15;
      const randomTrace = Math.random().toString(16).substring(2, 18) + Math.random().toString(16).substring(2, 18);

      setLogs((prev) => [
        {
          id: Math.random().toString(36).substring(7),
          time: new Date().toLocaleTimeString(),
          method: randomRoute.method,
          route: randomRoute.path,
          status: randomRoute.status,
          latency: randomLatency,
          trace: randomTrace,
        },
        ...prev.slice(0, 19),
      ]);
    }, 1800);

    return () => clearInterval(interval);
  }, [isSimulating]);

  return (
    <div className="w-full bg-[#081325] text-slate-100 rounded-2xl border border-blue-900/40 shadow-2xl overflow-hidden font-sans">
      {/* Header bar */}
      <div className="bg-[#0b1b36] px-6 py-4 border-b border-blue-900/50 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center space-x-3">
          <div className="p-2.5 bg-blue-600/20 rounded-xl border border-blue-500/30 text-blue-400">
            <Server className="w-5 h-5" />
          </div>
          <div>
 components/chase/ChaseErrorCatalog.tsx
assName="text-slate-400">CLPWPE Service Error Code</span>
              <span className="font-mono text-white bg-slate-800 px-2 py-0.5 rounded">
                {selectedError.serviceErrorCode || 'None'}
              </span>
            </div>
            <div className="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
              <span className="text-slate-400">External Partner Code</span>
              <span className="font-mono text-emerald-400 bg-slate-800 px-2 py-0.5 rounded">
                {selectedError.externalErrorCode || 'None'}
              </span>
            </div>
            <div className="flex items-center justify-between text-xs">
              <span className="text-slate-400">Applicable Endpoints</span>
              <span className="text-slate-300 font-mono">
                {selectedError.applicableEndpoints.join(', ')}
              </span>
            </div>
          </div>

          <div className="space-y-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">
              Recommended Remediation Action
            </span>
            <div className="p-3.5 bg-blue-950/40 border border-blue-800/40 rounded-xl text-xs text-blue-200 leading-relaxed">
              {selectedError.remediation}
            </div>
          </div>

          <div className="space-y-2">
            <div className="flex items-center justify-between">
              <span className="text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center space-x-1.5">
                <Code className="w-3.5 h-3.5 text-blue-400" />
                <span>Sample JSON Error Response</span>
              </span>
              <button
                onClick={() => copyToClipboard(JSON.stringify(selectedError.sampleJson, null, 2))}
                className="text-[11px] text-blue-400 hover:text-blue-300 flex items-center space-x-1"
              >
                {copied ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                <span>{copied ? 'Copied' : 'Copy JSON'}</span>
              </button>
            </div>
            <pre className="p-3.5 bg-black/60 rounded-xl border border-slate-800 font-mono text-[11px] text-amber-300 overflow-x-auto">
              {JSON.stringify(selectedError.sampleJson, null, 2)}
            </pre>
          </div>
        </div>
      </div>

      {/* Footer Info */}
      <div className="bg-slate-950 px-6 py-3 border-t border-slate-800 flex items-center justify-between text-xs text-slate-500">
        <span>Swagger Spec Definition: Error (base object for error response)</span>
        <span className="font-mono text-[11px]">x-chase-error-matrix-v1</span>
      </div>
    </div>
  );
};

